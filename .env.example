# Environment Variables — CreatorMind AI
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to source control.

# =============================================================
# SECURITY
# =============================================================
# A long, random secret key used to sign JWT tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# =============================================================
# DATABASE
# =============================================================
# SQLite (development default)
DATABASE_URL=sqlite:///./creatormind.db

# PostgreSQL (production recommended)
# DATABASE_URL=postgresql://user:password@localhost:5432/creatormind

# =============================================================
# IBM WATSONX / GRANITE AI
# =============================================================
# Get your API key from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_ibm_watsonx_api_key

# Your IBM Cloud project ID
WATSONX_PROJECT_ID=your_ibm_project_id

# IBM Watsonx endpoint (region-specific)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Granite model to use (e.g. "ibm/granite-13b-chat-v2")
GRANITE_MODEL_ID=ibm/granite-13b-chat-v2

# =============================================================
# CHROMADB
# =============================================================
# Path to the ChromaDB persistent store directory
CHROMA_DB_DIR=./chroma_data

# =============================================================
# APP SETTINGS
# =============================================================
APP_NAME=CreatorMind AI
VERSION=1.0.0
DEBUG=false

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================
# OPTIONAL — REDIS (for future v1.1.0 profile persistence)
# =============================================================
# REDIS_URL=redis://localhost:6379/0
