# ─── Application ─────────────────────────────────────────────
APP_NAME=CreatorMind API
VERSION=0.1.0
DEBUG=false

# ─── Auth ────────────────────────────────────────────────────
SUPABASE_URL=http://127.0.0.1:8000
SUPABASE_SERVICE_ROLE_KEY=local-dev-service-role
JWT_SECRET=local-dev-secret
DATABASE_URL=sqlite:///./creatormind.db

# ─── AI Provider ─────────────────────────────────────────────
# Options: mock | granite
AI_PROVIDER=mock

# ─── IBM watsonx.ai (required when AI_PROVIDER=granite) ──────
IBM_API_KEY=
IBM_PROJECT_ID=
IBM_URL=https://us-south.ml.cloud.ibm.com
IBM_MODEL_ID=ibm/granite-13b-chat-v2

# ─── RAG / ChromaDB ──────────────────────────────────────────
RAG_CHROMA_DB_DIR=./chroma_data
RAG_EMBEDDING_PROVIDER=mock
